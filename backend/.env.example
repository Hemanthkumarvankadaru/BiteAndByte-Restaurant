# Copy to backend/.env and uncomment only the lines you need. Loaded by application.yml
# (spring.config.import). Real values never go in git.
#
# Leave a line commented to keep the built-in default. An uncommented empty line such as
# "BITEANDBYTE_ADMIN_EMAIL=" sets an empty value, which overrides the default and can stop startup.

# --- Database (only for the postgres and oracle profiles; dev uses in-memory H2) ---
# Defaults: jdbc:postgresql://localhost:5432/biteandbyte and jdbc:oracle:thin:@//localhost:1521/orcl
# DB_URL=
# DB_USERNAME=biteandbyte
# DB_PASSWORD=

# --- Admin account created on first start ---
# Required outside the dev profile. The default admin/admin is for local dev only.
# BITEANDBYTE_ADMIN_PASSWORD=
# BITEANDBYTE_ADMIN_EMAIL=admin@biteandbyte-restaurant.local
# BITEANDBYTE_ADMIN_PHONE=9000000000

# --- Seeding and CORS ---
# Set to false to skip the sample menu on first start.
# BITEANDBYTE_SEED_MENU=true
# Comma-separated browser origins allowed to call the API.
# BITEANDBYTE_CORS_ORIGINS=http://localhost:5173

# --- Security (Phase 2) ---
# At least 32 random characters, for example from: openssl rand -base64 48
# BITEANDBYTE_JWT_SECRET=

# --- Razorpay (Phase 4), test-mode keys from the Razorpay dashboard ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Gmail SMTP (Phase 6). Needs 2FA and an App Password, not your login password ---
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- Server ---
# SERVER_PORT=8080
